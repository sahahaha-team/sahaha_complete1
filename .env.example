# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
# 크롤링·임베딩·Worker·대화 영구 저장에 필요. RLS 우회 가능하므로 서버에서만 사용
SUPABASE_SERVICE_KEY=

# ===== 로컬 Ollama LLM =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
CHATBOT_MAX_TOKENS=384
# true: 확인된 원문과 검증된 표 항목만 표시. false: Gemma 자유 요약(오류 가능)
SOURCE_ONLY_ANSWERS=true
SOURCE_MAX_AGE_DAYS=30
SOURCE_DYNAMIC_MAX_AGE_DAYS=7

# ===== Flask =====
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# 필수: 비워두면 서버가 시작되지 않음 (세션 위조 방지)
SECRET_KEY=replace_with_random_string_at_least_32_chars

# ===== 관리자 API 인증 =====
# /api/stats 등 관리자용 엔드포인트 인증 키
ADMIN_API_KEY=replace_with_random_admin_key

# ===== CORS =====
# 위젯 임베딩 허용 출처 (쉼표 구분)
CORS_ALLOWED_ORIGINS=https://www.saha.go.kr,https://saha.go.kr

# ===== Rate Limiting =====
RATE_LIMIT_CHAT=10 per minute

# ===== 대화 이력 보관 기간 =====
CONVERSATION_TTL_DAYS=30
# 기본 false: 대화는 서버 메모리에만 유지되고 Supabase에는 저장하지 않음
PERSIST_CONVERSATIONS=false

# ===== 별도 Worker 스케줄 =====
CRAWL_HOUR=3
CRAWL_MINUTE=0
CLEANUP_HOUR=4
CLEANUP_MINUTE=0
WORKER_RUN_ON_START=false

# ===== 하이브리드 검색 (Vector : BM25) =====
# 50개 행정 질의 그리드 서치 최적값
HYBRID_VECTOR_WEIGHT=0.30
HYBRID_BM25_WEIGHT=0.70
