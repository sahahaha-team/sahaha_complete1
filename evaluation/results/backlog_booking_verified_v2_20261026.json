      "server_timing": "search;dur=1910.3, verify;dur=1846.2, review_gate;dur=1.3, rerank;dur=3354.0, grounding;dur=101.2, originals;dur=0.0, review;dur=1.5, prepare;dur=156.4, app;dur=7427.7",
      "status": 200,
